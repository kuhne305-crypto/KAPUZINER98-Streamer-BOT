# Auf Railway: diese Werte unter "Variables" eintragen.
# Lokal: Datei in ".env" umbenennen und ausfüllen.

DISCORD_TOKEN=hier_der_bot_token
TWITCH_CLIENT_ID=hier_die_client_id
TWITCH_CLIENT_SECRET=hier_das_client_secret

# Optional, aber empfohlen: Server-ID (Rechtsklick auf Server -> "Server-ID kopieren")
# -> Slash-Befehle sind sofort da statt nach bis zu 1 Stunde
GUILD_ID=
